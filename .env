# Root .env — infrastructure for docker-compose.yml (Postgres, MariaDB, Redis,
# Traefik, PowerDNS, Stalwart). Copy to .env and set real secrets:
#   cp .env.example .env
#
# The defaults below match apps/api/.env.example. If you change a credential
# here, change it there too (DATABASE_URL, MARIADB_ADMIN_PASSWORD).

# --- PostgreSQL ---
POSTGRES_USER=upande
POSTGRES_PASSWORD=changeme
POSTGRES_DB=upande
POSTGRES_PORT=5432

# --- Redis (location on upande_net) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- MariaDB (Frappe apps) ---
# Must match MARIADB_ADMIN_PASSWORD in apps/api/.env.
MARIADB_ROOT_PASSWORD=changeme

# --- Auth ---
# Shared JWT signing secret; use the same value as JWT_SECRET in apps/api/.env.
JWT_SECRET=change-me-in-production-use-a-long-random-string

# --- Public URLs / ports ---
API_PORT=4000
DASHBOARD_URL=http://localhost:5173

# --- PowerDNS (authoritative DNS) ---
PDNS_DB=pdns
PDNS_API_KEY=changeme-pdns-api-key
DNS_BASE_DOMAIN=oponde.top

# --- Stalwart (managed mail) ---
MAIL_HOST=mail.localhost
MAIL_ADMIN_USER=admin
MAIL_ADMIN_PASSWORD=changeme-mail-admin

# --- Image registry for mirrored infrastructure images ---
MIRROR_REGISTRY=ghcr.io/zonaltech/zonal-cloud/mirror

# --- VPS only ---
# DOMAIN=yourdomain.com
