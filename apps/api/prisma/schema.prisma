// Prisma schema for Upande Cloud
// Backend agent owns this file.

generator client {
  provider        = "prisma-client-js"
  // Use the WASM query engine via a driver adapter so no native engine binary
  // is downloaded from binaries.prisma.sh (works on slow/locked-down networks).
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum OrganizationPlan {
  free
  pro
}

enum OrganizationStatus {
  active
  suspended
}

enum UserRole {
  user
  admin
  superadmin
}

enum UserStatus {
  active
  suspended
}

enum AppType {
  static
  node
  fullstack
  nodered
}

enum AppSource {
  git
  upload
}

enum AppStatus {
  idle
  building
  live
  failed
  stopped
}

// What started a deployment (deploy history). Null on rows created before
// this was tracked.
enum DeploymentTrigger {
  user // a signed-in user clicked Deploy / Migrate in the dashboard
  webhook // GitHub push webhook
  rollback // "Redeploy this version" of an earlier deployment
  api_token // a per-app deploy token (CI)
  admin // an admin / the MCP agent from the admin panel
  promote // "Promote to production" of a preview's already-built image
}

enum DeploymentStatus {
  queued
  building
  live
  failed
}

model Organization {
  // Human-readable, sequential ID like "UPC-000123", generated by the upc_org_id()
  // database function (see migration 20260925120000_organization_upc_id).
  id        String             @id @default(dbgenerated("upc_org_id()"))
  name      String
  slug      String             @unique
  plan      OrganizationPlan   @default(free)
  status    OrganizationStatus @default(active)
  createdAt DateTime           @default(now())

  // When the subscription lapses. Null = no expiry (e.g. free/perpetual plans).
  // An org is "expired" when this is set and in the past.
  subscriptionExpiresAt DateTime?
  // Last time the org showed activity (deploy, login, API call). Null = never
  // seen active. Used to flag "dormant" orgs that haven't done anything lately.
  lastActiveAt          DateTime?

  users                User[]
  projects             Project[]
  quota                Quota?
  dnsZones             DnsZone[]
  supportConversations SupportConversation[]
}

model User {
  id                 String     @id @default(cuid())
  organizationId     String
  username           String     @unique
  email              String     @unique
  passwordHash       String
  role               UserRole   @default(user)
  status             UserStatus @default(active)
  // When true, the user is forced to set a new password before they can use the
  // app. Set for the auto-seeded default admin and whenever an admin resets a
  // user's password from the UI. Cleared once the user picks their own password.
  mustChangePassword Boolean    @default(false)
  // Session generation, embedded in every JWT (`tv`). Bumped on password
  // change/reset (and admin password set / suspension) so older sessions stop
  // working.
  tokenVersion       Int        @default(0)
  // Light/dark UI preference, saved per account so it follows the user across
  // browsers. Null = not chosen yet (the app falls back to the OS setting).
  theme              String?
  // Numeric GitHub user id linked for "Sign in with GitHub". Set on GitHub
  // sign-in/sign-up (or when the user first connects GitHub for repos). Kept on
  // the user rather than GithubAccount so a login-only link never overwrites the
  // repo-scoped deploy token.
  githubId           String?    @unique
  createdAt          DateTime   @default(now())

  organization                 Organization          @relation(fields: [organizationId], references: [id])
  projects                     Project[]
  auditLogs                    AuditLog[]
  githubAccount                GithubAccount?
  resetTokens                  PasswordResetToken[]
  notifications                Notification[]
  // Deployments this user triggered (deploy history "who"). SetNull on delete.
  triggeredDeployments         Deployment[]          @relation("DeploymentTriggeredBy")
  // Support chat (SetNull on delete so the thread history survives the author).
  supportConversationsStarted  SupportConversation[] @relation("SupportConversationCreatedBy")
  supportConversationsResolved SupportConversation[] @relation("SupportConversationResolvedBy")
  supportMessages              SupportMessage[]
}

enum NotificationType {
  account_impersonated
  deployment_failed
  // A new support-chat message from the other side (admin -> user, user -> admin).
  support_message
}

// An in-app notice shown to a user. Used to tell a user when an admin signed in
// as them (impersonation) and when one of their deployments fails. Surfaced on
// the dashboard and shown until they clear it. Generic enough for future types.
model Notification {
  id             String           @id @default(cuid())
  userId         String
  // The org the recipient belongs to. Lets the admin panel query deployment
  // failures org-wide / cross-tenant without joining through the user each time.
  organizationId String?
  type           NotificationType
  message        String
  // Extra context (e.g. the impersonating admin's email, the start time).
  metadata       Json?
  readAt         DateTime?
  createdAt      DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt])
  @@index([organizationId, type, createdAt])
  // The admin Errors page + TopBar bell (polled every 20s on every page) query
  // `type='deployment_failed' ORDER BY createdAt desc` cross-tenant (no org), so
  // the org-leading index above can't serve it. This type-leading one does.
  @@index([type, createdAt])
  // The dashboard bell (polled every 20s per user) lists `userId` filtered by
  // `createdAt >= startOfToday ORDER BY createdAt desc`, and the user's Errors
  // page lists `userId` + type `ORDER BY createdAt desc`. This serves both.
  @@index([userId, createdAt])
}

model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  // SHA-256 hash of the reset token; the plaintext is only sent to the user.
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model GithubAccount {
  id          String   @id @default(cuid())
  userId      String   @unique
  githubId    String
  login       String
  // OAuth access token, encrypted at rest (aes-256-gcm via encrypt.util).
  accessToken String
  scope       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

model Quota {
  id                   String @id @default(cuid())
  organizationId       String @unique
  maxApps              Int    @default(5)
  cpu                  String @default("1")
  memory               String @default("512m")
  disk                 String @default("5g")
  buildMinutes         Int    @default(60)
  maxConcurrentDeploys Int    @default(2)
  // Managed-DNS hosting product: how many DNS zones the org may host. 0 = the
  // org has not bought the DNS add-on. Bumped by an admin/billing on purchase.
  maxDnsZones          Int    @default(0)

  organization Organization @relation(fields: [organizationId], references: [id])
}

model Project {
  id             String @id @default(cuid())
  organizationId String
  userId         String
  name           String
  slug           String @unique

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  apps         App[]
}

model App {
  id                 String    @id @default(cuid())
  projectId          String
  name               String
  type               AppType   @default(static)
  source             AppSource @default(git)
  repoUrl            String?
  branch             String?
  subdomain          String    @unique
  buildCmd           String?
  outputDir          String?
  status             AppStatus @default(idle)
  createdAt          DateTime  @default(now())
  // GitHub connection (set when source = git and repo connected via OAuth).
  githubRepoFullName String?
  githubWebhookId    String?
  webhookSecret      String?

  // Node-RED apps (type = nodered). The Node-RED data dir (flows, installed
  // nodes, settings.js) lives in this named Docker volume so it survives
  // redeploys/restarts. Editor access is controlled by NodeRedUser records,
  // which are rendered into settings.js (adminAuth) at deploy time.
  noderedVolumeName       String?
  // Each Node-RED instance is published on its own host port (container :1880
  // mapped to this port on the Docker host), allocated from 1880 upward. Unique
  // across Node-RED apps so two instances never collide on the host.
  noderedPort             Int?    @unique
  // The default "admin" editor account's password, stored encrypted (aes-256-gcm
  // via encrypt.util) so the dashboard can sign the user straight into the editor
  // ("Login as administrator") via Node-RED's /auth/token. Kept in sync whenever
  // the admin account's password is set through the platform. Plaintext is never
  // persisted.
  noderedAdminPasswordEnc String?

  // Health check run after every deploy against the NEW container, inside the
  // Docker network (container IP), before it replaces the running one.
  //   healthCheckPath null → just "is the web server answering" (any HTTP
  //   response on "/"); set → GET <path> must return 2xx/3xx.
  // Static apps always use the web-server check.
  healthCheckPath    String?
  // Seconds each probe may take before it counts as a failure.
  healthCheckTimeout Int     @default(5)
  // Probes (HEALTH_CHECK_INTERVAL_MS apart) before the deploy is failed.
  healthCheckRetries Int     @default(10)

  // GitHub PR integration (apps connected to a GitHub repo). Both default on.
  //   githubCommitStatus → commit status checks on the deployed SHA
  //   githubPrComments   → one preview comment per PR, edited on each deploy
  githubCommitStatus Boolean @default(true)
  githubPrComments   Boolean @default(true)

  project           Project            @relation(fields: [projectId], references: [id])
  deployments       Deployment[]
  envVars           EnvVar[]
  deployTokens      DeployToken[]
  customDomains     CustomDomain[]
  database          AppDatabase?
  noderedUsers      NodeRedUser[]
  previews          Preview[]
  uptimeChecks      UptimeCheck[]
  previewProtection PreviewProtection?
}

// Password-protected previews: when a row exists every preview URL of the app
// requires HTTP basic auth (Traefik basicAuth middleware on preview routers
// only; production is never protected). Only a bcrypt hash is stored — never
// the password. Kept off the App row so app payloads never carry the hash.
model PreviewProtection {
  appId        String   @id
  username     String
  passwordHash String
  updatedAt    DateTime @updatedAt

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)
}

// A preview deploy of a non-production branch: its own container
// (upande-preview-<subdomain>), image repo and Traefik router on
// <subdomain>.<BASE_DOMAIN>, where subdomain = <app subdomain>-<branch slug>.
// Never shares the production database — DB-backed previews get their own
// throwaway database (dbName/roleName), dropped with the preview.
// Limits: PREVIEW_MAX_PER_APP / PREVIEW_MAX_PER_ORG (see previews.service.ts).
model Preview {
  id               String           @id @default(cuid())
  appId            String
  branch           String
  subdomain        String           @unique
  status           DeploymentStatus @default(queued)
  imageRef         String?
  commitSha        String?
  lastDeploymentId String?
  lastDeployedAt   DateTime?
  createdByUserId  String?
  // Throwaway database for DB-backed previews (never the production DB).
  dbName           String?
  dbRoleName       String?
  dbPasswordEnc    String?
  // GitHub PR integration: the open PR for this branch and the bot comment
  // on it (edited in place on later deploys instead of posting new ones).
  githubPrNumber   Int?
  githubCommentId  String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  app         App          @relation(fields: [appId], references: [id], onDelete: Cascade)
  deployments Deployment[]

  @@unique([appId, branch])
}

// One editor account for a Node-RED app (type = nodered). Node-RED's
// `adminAuth` stores users with a bcrypt password hash and a permission level:
// "*" = full access (deploy/install/edit), "read" = read-only. These records
// are rendered into the container's settings.js at deploy time (and on every
// account change, which rewrites settings.js + restarts the container). The
// password is kept only as a bcrypt hash — the plaintext is never stored.
model NodeRedUser {
  id           String   @id @default(cuid())
  appId        String
  username     String
  passwordHash String
  // "*" = full admin access, "read" = read-only.
  permission   String   @default("*")
  createdAt    DateTime @default(now())

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@unique([appId, username])
  @@index([appId])
}

// A managed Postgres database + scoped role provisioned for a single app inside
// the platform's shared Postgres server (the same server the platform itself
// uses — "reuse the db"). Each app gets its own database AND its own role, so
// one app cannot read another's data. The role password is stored encrypted at
// rest (aes-256-gcm via encrypt.util); DATABASE_URL is assembled on demand and
// injected into the app container at deploy time, never persisted in plaintext.
model AppDatabase {
  id          String   @id @default(cuid())
  appId       String   @unique
  // The created Postgres database name and login role (both derived from the
  // app subdomain, sanitized to a safe identifier).
  dbName      String
  roleName    String
  passwordEnc String
  // Host/port the APP CONTAINER uses to reach Postgres (in-network service
  // name, e.g. "postgres:5432"), which differs from how the API connects.
  host        String   @default("postgres")
  port        Int      @default(5432)
  createdAt   DateTime @default(now())

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)
}

model CustomDomain {
  id              String             @id @default(cuid())
  appId           String
  domain          String             @unique
  status          CustomDomainStatus @default(pending)
  // Random token the user proves ownership with via a TXT record.
  verifyToken     String
  verifiedAt      DateTime?
  createdAt       DateTime           @default(now())
  // Set when the domain lives in a platform-hosted DnsZone owned by the same
  // org: ownership is proven by that zone (no TXT needed). Bare zone name.
  dnsZoneName     String?
  // The routing RRset the platform created in that zone (only set when WE
  // created it, so removing the domain deletes only our own record).
  autoRecordType  String?
  autoRecordValue String?
  // Outcome of the last verification (what was queried/found/expected), shown
  // in the dashboard so a failure explains itself.
  lastCheck       Json?

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId])
}

enum CustomDomainStatus {
  pending
  verified
  failed
}

model Deployment {
  id        String           @id @default(cuid())
  appId     String
  ref       String?
  status    DeploymentStatus @default(queued)
  imageRef  String?
  logsRef   String?
  createdAt DateTime         @default(now())

  // ---- Deploy history ----
  trigger           DeploymentTrigger?
  // The user who triggered it (user / rollback / admin triggers).
  triggeredByUserId String?
  // The deploy token used (trigger = api_token). Not a FK: tokens are deleted
  // with the app; the name is snapshotted into triggerDetail.
  deployTokenId     String?
  // Free-form extra context: token name, "push by <login>", "migrate", ...
  triggerDetail     String?
  // Commit that was built (filled from the clone; webhooks prefill it).
  commitSha         String?
  commitMessage     String?
  // Migrate / clean rebuild (no build cache).
  forceClean        Boolean            @default(false)
  // When the worker picked the job up / when it reached a terminal state.
  startedAt         DateTime?
  finishedAt        DateTime?
  // Human-readable failure reason (terminal failures only).
  errorReason       String?
  // Rollback: the earlier deployment whose version this one redeployed.
  rollbackOfId      String?
  // Preview deploy (non-production branch). null = a production deployment;
  // production history / rollback / logs only look at previewId = null.
  previewId         String?

  app         App            @relation(fields: [appId], references: [id])
  triggeredBy User?          @relation("DeploymentTriggeredBy", fields: [triggeredByUserId], references: [id], onDelete: SetNull)
  log         DeploymentLog?
  rollbackOf  Deployment?    @relation("DeploymentRollback", fields: [rollbackOfId], references: [id], onDelete: SetNull)
  rollbacks   Deployment[]   @relation("DeploymentRollback")
  preview     Preview?       @relation(fields: [previewId], references: [id], onDelete: SetNull)

  // The Metrics performance query filters `appId IN (...) AND createdAt >= since`
  // and analyzeLatestForApp does `findFirst({ where: appId }, orderBy createdAt)`.
  // This composite index serves both without a table scan + in-memory sort.
  @@index([appId, createdAt])
}

// The full build log of a deployment, persisted from Redis (where the live
// stream lives with a 1h TTL) when the deployment reaches a terminal state, so
// history keeps every deployment's log. Lines keep the "@ts:<ms>\x1f" prefix.
model DeploymentLog {
  deploymentId String   @id
  // Newline-joined log lines.
  content      String
  lineCount    Int
  // True when the log exceeded DEPLOY_LOG_MAX_BYTES and only the tail was kept.
  truncated    Boolean  @default(false)
  createdAt    DateTime @default(now())

  deployment Deployment @relation(fields: [deploymentId], references: [id], onDelete: Cascade)
}

model EnvVar {
  id       String  @id @default(cuid())
  appId    String
  key      String
  value    String
  isSecret Boolean @default(false)
  // Which deploys get it: all (default) | production | preview. The same key
  // may exist once per scope; a scoped value beats the `all` one.
  scope    String  @default("all")

  app App @relation(fields: [appId], references: [id])

  @@unique([appId, key, scope])
}

model DeployToken {
  id          String    @id @default(cuid())
  appId       String
  name        String
  hashedToken String    @unique
  lastUsedAt  DateTime?

  app App @relation(fields: [appId], references: [id])
}

model AuditLog {
  id          String   @id @default(cuid())
  actorUserId String?
  action      String
  target      String
  metadata    Json?
  ip          String?
  createdAt   DateTime @default(now())

  actor User? @relation(fields: [actorUserId], references: [id])

  // The admin Audit page does `orderBy createdAt desc, take 500` joining `actor`.
  // Index createdAt for the sort/limit, and actorUserId for the join.
  @@index([createdAt])
  @@index([actorUserId])
}

// Platform-wide key/value settings managed by superadmins (e.g. the MCP/agent
// API base URL and token). Secret values are stored encrypted at rest.
model Setting {
  key       String   @id
  value     String
  encrypted Boolean  @default(false)
  updatedAt DateTime @updatedAt
}

// Long-lived, revocable token for the MCP agent (not an expiring JWT). Only the
// SHA-256 hash is stored; the plaintext is shown once at creation. Authenticates
// to the API with the role/org of the superadmin who created it.
model AgentToken {
  id             String    @id @default(cuid())
  name           String
  tokenHash      String    @unique
  // The user/organization the agent acts as (the creating superadmin).
  userId         String
  organizationId String
  role           String    @default("superadmin")
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime  @default(now())
}

enum DnsZoneStatus {
  // Zone created in PowerDNS and serving; customer still needs to point their
  // registrar NS records at ns1/ns2 for it to be authoritative on the internet.
  active
  // Soft-disabled (e.g. unpaid). Records remain in PowerDNS but the API blocks
  // edits; a hard delete removes the zone from PowerDNS entirely.
  suspended
}

// A managed DNS zone (one customer domain, e.g. "example.com") hosted on the
// platform's PowerDNS nameservers (ns1/ns2). This is the ownership + billing
// record in the app database. The authoritative record data (A/AAAA/CNAME/MX/…)
// lives in PowerDNS's own `pdns` database and is manipulated via its HTTP API —
// it is NOT duplicated here. Keyed by the canonical zone name (no trailing dot).
model DnsZone {
  id             String        @id @default(cuid())
  organizationId String
  // Canonical apex domain, lowercased, no trailing dot (e.g. "example.com").
  // PowerDNS stores it with a trailing dot; the API normalizes on the boundary.
  name           String        @unique
  status         DnsZoneStatus @default(active)
  createdAt      DateTime      @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId])
}

enum SupportConversationStatus {
  open
  closed
}

enum SupportCategory {
  issue
  inquiry
  faqs
  custom
}

enum SupportAuthorRole {
  user
  admin
}

// text = a normal chat bubble; resolution_request = an admin's "Is this
// solved?" question; resolution_answer = the user's Yes/No reply to it.
enum SupportMessageKind {
  text
  resolution_request
  resolution_answer
}

// pending = a question is awaiting the user's answer; solved / unsolved = the
// last answer. Cleared (null) on reopen and when a pending question is dropped
// by a manual close.
enum SupportResolution {
  pending
  solved
  unsolved
}

// A support-chat thread between an organization's members and the platform
// admins. Org-scoped: every member of the org can see and reply to its threads.
// Unread tracking is per side (the whole org shares the user-side counter; all
// admins share the admin-side counter) rather than per person.
model SupportConversation {
  id               String                    @id @default(cuid())
  organizationId   String
  createdByUserId  String?
  // The display title: the category label ("Issue", "Inquiry", "FAQs") or the
  // user's own title for Custom.
  subject          String
  category         SupportCategory
  // Immutable "ISSUE-0001"-style reference, one sequence per category. Assigned
  // by the SupportConversation_reference trigger (the '' default is replaced).
  reference        String                    @unique @default("")
  status           SupportConversationStatus @default(open)
  lastMessageAt    DateTime                  @default(now())
  // Messages the user side / admin side hasn't read yet.
  userUnreadCount  Int                       @default(0)
  adminUnreadCount Int                       @default(0)
  userLastReadAt   DateTime?
  adminLastReadAt  DateTime?
  closedAt         DateTime?
  resolution       SupportResolution?
  // Set when a member answered "Yes" (solved).
  resolvedAt       DateTime?
  resolvedByUserId String?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt

  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User?            @relation("SupportConversationCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  resolvedBy   User?            @relation("SupportConversationResolvedBy", fields: [resolvedByUserId], references: [id], onDelete: SetNull)
  messages     SupportMessage[]

  @@index([organizationId, lastMessageAt])
  @@index([status, lastMessageAt])
  @@index([category, lastMessageAt])
  @@index([lastMessageAt])
}

model SupportMessage {
  id             String             @id @default(cuid())
  conversationId String
  authorUserId   String?
  authorRole     SupportAuthorRole
  body           String
  kind           SupportMessageKind @default(text)
  // resolution_answer only: true = solved, false = not solved yet.
  answer         Boolean?
  createdAt      DateTime           @default(now())

  conversation SupportConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author       User?               @relation(fields: [authorUserId], references: [id], onDelete: SetNull)

  @@index([conversationId, createdAt])
}

// One uptime probe of a live app's production container (uptime monitor,
// every UPTIME_CHECK_INTERVAL_SECONDS; raw rows kept UPTIME_RETENTION_DAYS).
model UptimeCheck {
  id         String   @id @default(cuid())
  appId      String
  checkedAt  DateTime @default(now())
  up         Boolean
  // HTTP status of the probe; null when there was no response.
  statusCode Int?
  // Time to response headers; null when there was no response.
  latencyMs  Int?
  // Why the check counted as down (null when up).
  error      String?

  app App @relation(fields: [appId], references: [id], onDelete: Cascade)

  @@index([appId, checkedAt])
  @@index([checkedAt])
}
