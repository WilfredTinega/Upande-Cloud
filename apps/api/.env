# Database
# Must match the PostgreSQL credentials in the root .env (POSTGRES_USER/PASSWORD/DB).
# The API runs on the host in dev, so it connects to PostgreSQL via localhost.
DATABASE_URL="postgresql://upande:changeme@localhost:5432/upande"

# Redis
REDIS_HOST=localhost
# 6380 on the host (see docker-compose.override.yml); 6379 inside upande_net.
REDIS_PORT=6380

# JWT
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES_IN=7d

# --- First-install default admin ---
# On startup, if NO superadmin exists, the API auto-seeds one so you can sign in
# to the admin panel immediately. Sign in with the email OR username below, then
# you are forced to set a strong (8+ char) password before the panel opens.
# Recovery if the password is later forgotten stays on the CLI:
#   npm run create-superadmin -- <email> <password>
# DEFAULT_ADMIN_USERNAME=administrator
# DEFAULT_ADMIN_EMAIL=admin@example.com
# DEFAULT_ADMIN_PASSWORD=admin
# DEFAULT_ADMIN_ORG=Administrator

# Encryption key for env var values (32-byte hex string)
ENCRYPTION_KEY=5dc1b1dbbe88cfec3a1f72b0bed22c4b96a1a77afca45c9de400da6f87b63160
# App base domain for routing
BASE_DOMAIN=localhost
# Public port for Traefik's HTTP entrypoint. Locally Traefik maps to 8090
# (system nginx holds :80) so apps are at http://<slug>.localhost:8090.
# Set to "" or "80" once :80 is free / on the VPS where Traefik owns :80/:443.
APP_HTTP_PORT=80
APP_HTTP_SCHEME=http

# Docker network for deployed app containers
DOCKER_NETWORK=upande_net

# Where uploaded app source folders are stored (one subdir per app id). The
# deploy pipeline copies from here for source=upload apps.
UPLOAD_ROOT=/tmp/upande-uploads

# Managed per-app databases (full-stack apps). The platform provisions a
# dedicated database + scoped role inside the SHARED Postgres server and injects
# DATABASE_URL into the app container.
#   APP_DB_ADMIN_URL — admin connection used to run CREATE ROLE/DATABASE.
#     Defaults to DATABASE_URL (the `upande` superuser). Override if the API
#     should use a different admin DSN than its own metadata DB.
#   APP_DB_HOST/APP_DB_PORT — how the APP CONTAINER reaches Postgres. On the
#     shared upande_net network this is the compose service name "postgres:5432",
#     NOT localhost (that's only how the host-run API connects).
# APP_DB_ADMIN_URL="postgresql://upande:changeme@localhost:5432/upande"
APP_DB_HOST=postgres
APP_DB_PORT=5432

# Traefik certificate resolver for custom domains (VPS only). When set, verified
# custom domains get HTTPS via Let's Encrypt. Leave blank locally (HTTP only).
# Must match the resolver name configured in services/proxy/traefik.yml.
ACME_RESOLVER=

# Node environment
NODE_ENV=development

# --- GitHub OAuth (connect repos + push-to-deploy) ---
# Create an OAuth App at https://github.com/settings/developers
#   Homepage URL:               http://localhost:5173
#   Authorization callback URL: http://localhost:4000/v1/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# Optional: separate HMAC secret for the OAuth `state` param (falls back to JWT_SECRET)
GITHUB_STATE_SECRET=
# Public URLs used to build OAuth callback + webhook URLs and the post-connect redirect.
# In production these must be the public origins; locally the defaults work.
API_PUBLIC_URL=http://localhost:4000
DASHBOARD_URL=http://localhost:5173
# Comma-separated CORS origins for the API (dashboard + admin).
CORS_ORIGINS=http://localhost:5173,http://localhost:5174

# --- Email / SMTP (password reset) ---
# If SMTP_HOST is set, password-reset links are emailed via Nodemailer.
# If left blank, the API runs in dev mode: the reset link is returned in the
# forgot-password response and logged (no email sent).
# Local option: run Mailpit (see docker-compose.yml) and use the values below,
# then read the email at http://localhost:8025.
#   SMTP_HOST=localhost
#   SMTP_PORT=1025
#   SMTP_USER=
#   SMTP_PASS=
#   SMTP_FROM=Upande Cloud <no-reply@upande.local>
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Upande Cloud <no-reply@upande.local>

# --- AI (admin deploy-log analyzer, Mistral Agents API) ---
# Create an agent at https://console.mistral.ai and paste its id below.
# If either value is blank, the "Explain with AI" feature is disabled gracefully.
MISTRAL_API_KEY=
MISTRAL_AGENT_ID=
# Optional override of the Agents endpoint.
# MISTRAL_API_URL=https://api.mistral.ai/v1/agents/completions

# PowerDNS (managed DNS). The API runs on the host in dev, so use the
# published port rather than the in-network hostname "pdns".
PDNS_API_URL=http://localhost:8081
PDNS_API_KEY=changeme-pdns-api-key
DNS_BASE_DOMAIN=oponde.top
